    "@testing-library/user-event": "14.6.4",
    "@types/d3": "7.4.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "oxlint": "1.78.0",
